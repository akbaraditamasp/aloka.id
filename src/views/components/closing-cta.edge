{{-- Shared closing CTA panel (dark radial-gradient banner) used at the end of every page.
     `icon` and `heading` are slots, not props — Tailwind's class scanner works on literal source
     text, so an icon class built from an interpolated prop (`icon-[{{ icon }}]`) would never match
     a real utility. Passing the full `<span class="icon-[tabler--x] ...">` as a slot keeps that
     class string literal in the calling page where the scanner can see it. `heading` is a slot
     (not a prop) so callers can embed inline markup, e.g. an amber-highlighted word. --}}
<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="relative overflow-hidden rounded-3xl px-8 py-16 md:px-16 md:py-20 text-center" style="background: radial-gradient(ellipse 100% 100% at 50% 0%, rgba(0,173,238,0.45) 0%, rgba(0,173,238,0.25) 45%, rgba(0,173,238,0.1) 75%, transparent 100%), linear-gradient(180deg, #0b0f30 0%, #14204f 40%, #1D4282 70%, #242A6A 100%);">
      <img src="{{ vite.static('ornament-hero-abstract.svg') }}" alt="" class="pointer-events-none select-none absolute -top-16 -right-16 md:-top-24 md:-right-24 w-72 md:w-96" />
      <img src="{{ vite.static('ornament-hero-abstract.svg') }}" alt="" class="pointer-events-none select-none absolute -bottom-16 -left-16 md:-bottom-24 md:-left-24 w-72 md:w-96 rotate-180" />

      <div class="relative">
        {{-- items-start (not items-center) + mt-0.5 on the icon keeps it pinned to the first line's
             cap-height instead of drifting to the vertical center once the label wraps to 2 lines —
             the bug this component was built to fix. --}}
        <span class="inline-flex items-start justify-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber">
          <span class="mt-0.5 shrink-0">{{{ await $slots.icon() }}}</span>
          <span>{{ eyebrow }}</span>
        </span>
        <h2 class="mt-4 font-display font-extrabold text-3xl md:text-5xl text-white leading-tight max-w-2xl mx-auto">
          {{{ await $slots.heading() }}}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/80 max-w-xl mx-auto">
          {{ body }}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="{{ primaryHref }}" class="inline-flex items-center gap-3 rounded-full bg-accent-amber pl-6 pr-2 py-2 text-sm font-semibold text-brand-navy transition-colors hover:bg-accent-amber-dark">
            {{ primaryLabel }}
            <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy">
              <span class="icon-[tabler--arrow-right] size-4"></span>
            </span>
          </a>
          <a href="{{ secondaryHref }}" class="inline-flex items-center gap-1.5 rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            {{ secondaryLabel }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
