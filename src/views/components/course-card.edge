{{-- Catalog card shared by the course list page and (later) related-course strips. Props: `item`
     (a course record) and `index` (only used to rotate the placeholder photo when a course has no
     thumbnail yet). Badge colors are literal class strings so Tailwind's scanner sees them. --}}
@let(badgeColor = { TATA_KELOLA: 'text-brand-blue', KEUANGAN: 'text-brand-blue', LEGALITAS: 'text-accent-amber-dark', DIGITALISASI: 'text-success' })
<a href="/kelas-elearning/{{ item.slug }}" class="group flex flex-col rounded-2xl border border-border bg-white overflow-hidden shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
  <div class="relative aspect-video shrink-0 bg-surface">
    @if(item.thumbnail && item.thumbnail.url)
      <img src="{{ imgOptimize(item.thumbnail.url, { w: 640 }) }}" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    @else
      <img src="{{ vite.static('akademi-' + (((index || 0) % 3) + 1) + '.jpg') }}" alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    @end
    <span class="absolute top-3 left-3 rounded-full bg-white px-3 py-1 text-xs font-semibold shadow-sm {{ badgeColor[item.category] || 'text-brand-blue' }}">{{ optionLabel('courseCategory', item.category) }}</span>
  </div>
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-lg text-ink">{{ item.title }}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-muted flex-1">{{ item.summary }}</p>
    <div class="mt-5 flex items-center justify-between text-xs font-semibold text-ink-muted">
      <div class="flex items-center gap-3">
        <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('courseLevel', item.level) }}</span>
        <span class="flex items-center gap-1"><span class="icon-[tabler--clock] size-3.5"></span> {{ item.durationMinutes }} Menit</span>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
      <span class="font-mono text-base font-bold text-ink tabular-nums">{{ formatRupiah(item.price) }}</span>
      <span class="icon-[tabler--arrow-right] size-4 text-brand-blue transition-transform duration-300 group-hover:translate-x-1"></span>
    </div>
  </div>
</a>
