@let(site = await general.get())
<footer class="bg-ink text-white/70">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-6 gap-10">
      <div class="sm:col-span-2 lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          {{-- STYLE.md §2: a plain monochrome mark is used when the gradient doesn't reproduce well —
               here it blends into the navy footer background, so render it plain white via filter
               instead of needing a separate asset. --}}
          <img src="{{ vite.static('logo.png') }}" alt="" class="h-12 w-12 -my-2" style="filter: brightness(0) invert(1);" />
          <span class="font-display font-bold text-white text-2xl">aloka</span>
        </a>
        <p class="mt-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-white/50">{{ site.motto }}</p>
        <p class="mt-4 text-sm leading-relaxed max-w-xs">
          {{ site.description }}
        </p>
        <div class="mt-6 flex flex-col gap-2.5 text-sm">
          <a href="{{ waLink(site.whatsapp) }}" class="inline-flex items-center gap-2 hover:text-white transition-colors">
            <span class="icon-[tabler--brand-whatsapp] size-4"></span>
            +{{ site.whatsapp }}
          </a>
          <a href="mailto:{{ site.email }}" class="inline-flex items-center gap-2 hover:text-white transition-colors">
            <span class="icon-[tabler--mail] size-4"></span>
            {{ site.email }}
          </a>
        </div>
      </div>

      {{-- Mirrors the header's 4 consolidated dropdowns, with a short curated set of links per
           group (not every anchor) so the footer stays a quick-scan summary, not a full sitemap. --}}
      <div>
        <p class="font-display font-semibold text-white text-sm">Akademi</p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a href="/kelas-elearning" class="hover:text-white transition-colors">Kelas E-Learning</a>
          <a href="/sertifikasi-bnsp" class="hover:text-white transition-colors">Sertifikasi BNSP</a>
          <a href="/event/tipe/webinar" class="hover:text-white transition-colors">Webinar</a>
        </div>
      </div>

      <div>
        <p class="font-display font-semibold text-white text-sm">Konsultasi</p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a href="/konsultasi#ada-masalah" class="hover:text-white transition-colors">Ada Masalah Koperasi?</a>
          <a href="/konsultasi#art" class="hover:text-white transition-colors">ART &amp; Persus</a>
          <a href="/konsultasi#pelaporan-rat" class="hover:text-white transition-colors">Pelaporan RAT</a>
          <a href="/konsultan-pajak" class="hover:text-white transition-colors">Konsultan Pajak</a>
          <a href="/laporan-keuangan" class="hover:text-white transition-colors">Laporan Keuangan</a>
        </div>
      </div>

      <div>
        <p class="font-display font-semibold text-white text-sm">Legalitas &amp; Perizinan</p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a href="/legalitas#akta" class="hover:text-white transition-colors">Akta &amp; SK Kemenkumham</a>
          <a href="/legalitas#nib" class="hover:text-white transition-colors">NIB</a>
          <a href="/izin-ksp-usp" class="hover:text-white transition-colors">Izin KSP/USP</a>
          <a href="/pembiayaan" class="hover:text-white transition-colors">Akses Pembiayaan</a>
        </div>
      </div>

      <div>
        <p class="font-display font-semibold text-white text-sm">Tentang Kami</p>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a href="/fasilitator" class="hover:text-white transition-colors">Fasilitator</a>
          <a href="/event" class="hover:text-white transition-colors">Event</a>
          <a href="/tentang" class="hover:text-white transition-colors">Tentang Aloka</a>
          <a href="/kontak" class="hover:text-white transition-colors">Kontak</a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/50">
      <p>© {{ new Date().getFullYear() }} {{ site.siteName }}. Seluruh hak cipta dilindungi.</p>
      <div class="flex items-center gap-4">
        <a href="/kelas-elearning" class="hover:text-white transition-colors">Daftar Sekarang</a>
      </div>
    </div>
  </div>
</footer>
