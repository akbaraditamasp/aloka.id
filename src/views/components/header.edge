<header
  x-data="{ mobileOpen: false, scrolled: false }"
  @scroll.window="scrolled = window.scrollY > 8"
  class="sticky top-0 z-50 transition-colors duration-300"
  :class="scrolled ? 'bg-surface-white/90 backdrop-blur' : 'bg-transparent'"
>
  <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="{{ vite.static('logo.png') }}" alt="" class="h-12 w-12 -my-2" />
      <span class="font-display font-bold text-brand-navy text-2xl">aloka</span>
    </a>

    <div class="hidden lg:flex items-center gap-1 rounded-full bg-brand-navy p-2">
      <nav class="flex items-center gap-1 font-sans text-sm font-medium text-white/80">
        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/akademi') ? 'text-white bg-white/10' : '' }}">
            Akademi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/akademi/kelas-online" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--device-laptop] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Kelas Online</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Belajar perkoperasian &amp; laporan keuangan mandiri</span>
                </span>
              </a>
              <a href="/akademi/sertifikasi" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--certificate] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Sertifikasi</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Sertifikasi Kompetensi Aloka per skema</span>
                </span>
              </a>
              <a href="/akademi/webinar" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--presentation] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Webinar</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Jadwal webinar &amp; uji kompetensi rutin</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/konsultasi') ? 'text-white bg-white/10' : '' }}">
            Konsultasi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/konsultasi/online" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--headset] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Konsultasi Online</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Chat/video call terjadwal dengan pendamping</span>
                </span>
              </a>
              <a href="/konsultasi/panggil-pelatih" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--map-pin] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Panggil Pelatih</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Pelatih datang langsung ke lokasi koperasi</span>
                </span>
              </a>
              <a href="/konsultasi/laporan-keuangan" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--report-money] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Laporan Keuangan Koperasi</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Pendampingan penyusunan laporan, bukan cuma diajarkan</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/legalitas') ? 'text-white bg-white/10' : '' }}">
            Legalitas &amp; Pembiayaan
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/legalitas/pendirian" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--building] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Pendirian Koperasi</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Akta, SK Kemenkumham, NIB dari nol</span>
                </span>
              </a>
              <a href="/legalitas/izin-operasional" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--shield-check] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Izin Operasional KSP/USP</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Izin unit/koperasi simpan pinjam</span>
                </span>
              </a>
              <a href="/legalitas/pembiayaan" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--cash] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Akses Pembiayaan</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Pendampingan pengajuan ke bank &amp; program pemerintah</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <a href="/fasilitator" class="px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/fasilitator') ? 'text-white bg-white/10' : '' }}">Fasilitator</a>
        <a href="/event" class="px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/event') ? 'text-white bg-white/10' : '' }}">Event</a>
        <a href="/tentang" class="px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ request.path.startsWith('/tentang') ? 'text-white bg-white/10' : '' }}">Tentang</a>
      </nav>

      <div class="flex items-center gap-2 pl-2 ml-1 border-l border-white/15">
        <a href="/masuk" class="px-4 py-2 rounded-full text-sm font-medium text-white border border-white/25 hover:bg-white/10 transition-colors">Masuk</a>
        <a href="/daftar" class="px-4 py-2 rounded-full text-sm font-semibold text-brand-navy bg-accent-amber hover:bg-accent-amber-dark hover:text-white transition-colors">Daftar Sekarang</a>
      </div>
    </div>

    <button class="lg:hidden text-ink" @click="mobileOpen = !mobileOpen" aria-label="Buka menu">
      <span class="icon-[tabler--menu-2] size-6" x-show="!mobileOpen"></span>
      <span class="icon-[tabler--x] size-6" x-show="mobileOpen" x-cloak></span>
    </button>

    <div x-show="mobileOpen" x-cloak x-transition class="lg:hidden absolute left-4 right-4 top-full mt-2 rounded-2xl bg-surface-white border border-border shadow-lg max-h-[calc(100vh-6rem)] overflow-y-auto">
      <div class="px-4 py-4 flex flex-col gap-1 font-sans text-sm">
        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Akademi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/akademi/kelas-online" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--device-laptop] size-4 text-brand-blue"></span> Kelas Online
            </a>
            <a href="/akademi/sertifikasi" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--certificate] size-4 text-brand-blue"></span> Sertifikasi
            </a>
            <a href="/akademi/webinar" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--presentation] size-4 text-brand-blue"></span> Webinar
            </a>
          </div>
        </div>

        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Konsultasi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/konsultasi/online" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--headset] size-4 text-brand-blue"></span> Konsultasi Online
            </a>
            <a href="/konsultasi/panggil-pelatih" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--map-pin] size-4 text-brand-blue"></span> Panggil Pelatih
            </a>
            <a href="/konsultasi/laporan-keuangan" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--report-money] size-4 text-brand-blue"></span> Laporan Keuangan Koperasi
            </a>
          </div>
        </div>

        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Legalitas &amp; Pembiayaan
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/legalitas/pendirian" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--building] size-4 text-brand-blue"></span> Pendirian Koperasi
            </a>
            <a href="/legalitas/izin-operasional" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--shield-check] size-4 text-brand-blue"></span> Izin Operasional KSP/USP
            </a>
            <a href="/legalitas/pembiayaan" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--cash] size-4 text-brand-blue"></span> Akses Pembiayaan
            </a>
          </div>
        </div>

        <a href="/fasilitator" class="py-2.5 font-medium text-ink">Fasilitator</a>
        <a href="/event" class="py-2.5 font-medium text-ink">Event</a>
        <a href="/tentang" class="py-2.5 font-medium text-ink">Tentang Aloka</a>
        <div class="flex flex-col gap-2 mt-3 pt-3 border-t border-border">
          <a href="/masuk" class="text-center px-5 py-2.5 rounded-full text-sm font-medium text-brand-blue border border-brand-blue">Masuk</a>
          <a href="/daftar" class="text-center px-5 py-2.5 rounded-full text-sm font-semibold text-brand-navy bg-accent-amber">Daftar Sekarang</a>
        </div>
      </div>
    </div>
  </div>
</header>
