<header
  x-data="{ mobileOpen: false, scrolled: false }"
  @scroll.window="scrolled = window.scrollY > 8"
  class="sticky top-0 z-50 transition-colors duration-300"
  :class="scrolled ? 'bg-surface-white/90 backdrop-blur' : 'bg-transparent'"
>
  <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="{{ vite.static('logo.png') }}" alt="" class="h-12 w-12 -my-2" />
      <span class="font-display font-bold text-brand-navy text-2xl">aloka</span>
    </a>

    {{-- Consolidated to 4 top-level dropdowns (down from the client's 9 standalone items) — 9 items
         side-by-side didn't fit well and read as visual clutter, so related pillars are grouped:
         Akademi absorbs Sertifikasi BNSP, Konsultasi absorbs Konsultan Pajak, Legalitas absorbs
         Izin KSP/USP as a second labeled group, and the old Fasilitator/Event/Tentang become one
         "Tentang Kami" dropdown. Every original destination page/anchor is still reachable. --}}
    <div class="hidden lg:flex items-center gap-1 rounded-full bg-brand-navy p-2">
      <nav class="flex items-center gap-1 font-sans text-sm font-medium text-white/80">
        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ (request.path.startsWith('/kelas-elearning') || request.path.startsWith('/sertifikasi-bnsp')) ? 'text-white bg-white/10' : '' }}">
            Akademi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/kelas-elearning" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--device-laptop] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Kelas E-Learning</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Belajar perkoperasian &amp; laporan keuangan mandiri</span>
                </span>
              </a>
              <a href="/sertifikasi-bnsp" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--certificate] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Sertifikasi Kompetensi BNSP</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Sertifikasi resmi berbasis standar nasional</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ (request.path.startsWith('/konsultasi') || request.path.startsWith('/konsultan-pajak')) ? 'text-white bg-white/10' : '' }}">
            Konsultasi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/konsultasi#ada-masalah" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-accent-amber/10 text-accent-amber-dark shrink-0">
                  <span class="icon-[tabler--message-question] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Ada Masalah Koperasi?</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Ceritakan kendala, kami arahkan layanannya</span>
                </span>
              </a>
              <a href="/konsultasi#art" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--book] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">ART</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Anggaran Rumah Tangga koperasi</span>
                </span>
              </a>
              <a href="/konsultasi#persus" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--gavel] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Persus</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Peraturan khusus internal koperasi</span>
                </span>
              </a>
              <a href="/konsultasi#sop" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--list-check] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">SOP</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Standar Operasional Prosedur</span>
                </span>
              </a>
              <a href="/konsultasi#pelaporan-rat" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--calendar-event] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Pelaporan RAT</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Pendampingan Rapat Anggota Tahunan</span>
                </span>
              </a>
              <a href="/konsultan-pajak" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--calculator] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Konsultan Pajak</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Pelaporan &amp; konsultasi pajak koperasi</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ (request.path.startsWith('/legalitas') || request.path.startsWith('/izin-ksp-usp') || request.path.startsWith('/pembiayaan')) ? 'text-white bg-white/10' : '' }}">
            Legalitas &amp; Perizinan
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          {{-- Collapsed to one row per pillar page (was 3 labeled groups / 8 sub-items — too long
               to scan). Each page has its own in-page quick-nav pills to the finer sub-items. --}}
          <div x-show="open" x-transition x-cloak class="absolute left-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/legalitas" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--file-text] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Legalitas Pendirian</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Akta, SK Kemenkumham, NPWP, NIB</span>
                </span>
              </a>
              <a href="/izin-ksp-usp" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--user-check] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Izin KSP/USP</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Syarat kelayakan izin operasional simpan pinjam</span>
                </span>
              </a>
              <a href="/pembiayaan" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--coins] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Akses Pembiayaan</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Bank, KUR, sampai LPDB-KUMKM</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
          <button class="flex items-center gap-1 px-3 py-2 rounded-full hover:bg-white/10 hover:text-white transition-colors {{ (request.path.startsWith('/fasilitator') || request.path.startsWith('/event') || request.path.startsWith('/tentang')) ? 'text-white bg-white/10' : '' }}">
            Tentang Kami
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-transition x-cloak class="absolute right-0 top-full pt-3 w-80">
            <div class="bg-surface-white border border-border rounded-2xl shadow-lg p-2">
              <a href="/fasilitator" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--users-group] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Fasilitator</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Profil pelatih &amp; konsultan berpengalaman</span>
                </span>
              </a>
              <a href="/event" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--calendar-event] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Event</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Kalender pelatihan &amp; webinar terdekat</span>
                </span>
              </a>
              <a href="/tentang" class="flex items-start gap-3 px-3 py-2.5 rounded-xl hover:bg-surface">
                <span class="flex items-center justify-center size-9 rounded-lg bg-surface text-brand-blue shrink-0">
                  <span class="icon-[tabler--info-circle] size-5"></span>
                </span>
                <span>
                  <span class="block font-medium text-ink">Tentang Aloka</span>
                  <span class="block text-xs text-ink-muted mt-0.5">Visi, misi, dan cerita singkat Aloka</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </nav>

      <div class="flex items-center gap-2 pl-2 ml-1 border-l border-white/15">
        <a href="/masuk" class="px-4 py-2 rounded-full text-sm font-medium text-white border border-white/25 hover:bg-white/10 transition-colors">Masuk</a>
        <a href="/daftar" class="px-4 py-2 rounded-full text-sm font-semibold text-brand-navy bg-accent-amber hover:bg-accent-amber-dark hover:text-white transition-colors">Daftar Sekarang</a>
      </div>
    </div>

    <button class="lg:hidden text-ink" @click="mobileOpen = !mobileOpen" aria-label="Buka menu">
      <span class="icon-[tabler--menu-2] size-6" x-show="!mobileOpen"></span>
      <span class="icon-[tabler--x] size-6" x-show="mobileOpen" x-cloak></span>
    </button>

    <div x-show="mobileOpen" x-cloak x-transition class="lg:hidden absolute left-4 right-4 top-full mt-2 rounded-2xl bg-surface-white border border-border shadow-lg max-h-[calc(100vh-6rem)] overflow-y-auto">
      <div class="px-4 py-4 flex flex-col gap-1 font-sans text-sm">
        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Akademi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/kelas-elearning" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--device-laptop] size-4 text-brand-blue"></span> Kelas E-Learning
            </a>
            <a href="/sertifikasi-bnsp" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--certificate] size-4 text-brand-blue"></span> Sertifikasi Kompetensi BNSP
            </a>
          </div>
        </div>

        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Konsultasi
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/konsultasi#ada-masalah" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--message-question] size-4 text-brand-blue"></span> Ada Masalah Koperasi?
            </a>
            <a href="/konsultasi#art" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--book] size-4 text-brand-blue"></span> ART
            </a>
            <a href="/konsultasi#persus" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--gavel] size-4 text-brand-blue"></span> Persus
            </a>
            <a href="/konsultasi#sop" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--list-check] size-4 text-brand-blue"></span> SOP
            </a>
            <a href="/konsultasi#pelaporan-rat" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--calendar-event] size-4 text-brand-blue"></span> Pelaporan RAT
            </a>
            <a href="/konsultan-pajak" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--calculator] size-4 text-brand-blue"></span> Konsultan Pajak
            </a>
          </div>
        </div>

        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Legalitas &amp; Perizinan
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/legalitas" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--file-text] size-4 text-brand-blue"></span> Legalitas Pendirian
            </a>
            <a href="/izin-ksp-usp" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--user-check] size-4 text-brand-blue"></span> Izin KSP/USP
            </a>
            <a href="/pembiayaan" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--coins] size-4 text-brand-blue"></span> Akses Pembiayaan
            </a>
          </div>
        </div>

        <div x-data="{ open: false }">
          <button type="button" @click="open = !open" class="w-full flex items-center justify-between py-2.5 font-medium text-ink">
            Tentang Kami
            <span class="icon-[tabler--chevron-down] size-4 transition-transform" :class="open && 'rotate-180'"></span>
          </button>
          <div x-show="open" x-cloak class="pl-1 pb-2 flex flex-col gap-1">
            <a href="/fasilitator" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--users-group] size-4 text-brand-blue"></span> Fasilitator
            </a>
            <a href="/event" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--calendar-event] size-4 text-brand-blue"></span> Event
            </a>
            <a href="/tentang" class="flex items-center gap-2.5 py-2 text-ink-muted">
              <span class="icon-[tabler--info-circle] size-4 text-brand-blue"></span> Tentang Aloka
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-2 mt-3 pt-3 border-t border-border">
          <a href="/masuk" class="text-center px-5 py-2.5 rounded-full text-sm font-medium text-brand-blue border border-brand-blue">Masuk</a>
          <a href="/daftar" class="text-center px-5 py-2.5 rounded-full text-sm font-semibold text-brand-navy bg-accent-amber">Daftar Sekarang</a>
        </div>
      </div>
    </div>
  </div>
</header>
