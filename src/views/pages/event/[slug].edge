@let(found = await event.read({ filters: { slug: params.slug, status: 'PUBLISH' }, limit: 1 }))
@let(item = found.data[0])
@if(!item)
  {{ abort(404) }}
@end
@let(site = await general.get())
@let(isPast = new Date(item.endAt || item.startAt).getTime() < Date.now())
@component('layouts/main', { request, description: item.summary })
  @slot('title')
    {{ item.title }} | Event Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <a href="/event" class="hover:text-brand-blue transition-colors">Event</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">{{ item.title }}</span>
        </nav>

        <div class="mt-10 grid lg:grid-cols-3 gap-10 lg:gap-16 items-start">
          <div class="lg:col-span-2">
            @if(item.thumbnail && item.thumbnail.url)
              <div class="relative aspect-video rounded-2xl overflow-hidden bg-surface border border-border">
                <img src="{{ imgOptimize(item.thumbnail.url, { w: 1200 }) }}" alt="{{ item.title }}" class="absolute inset-0 h-full w-full object-cover" />
              </div>
            @end

            <div class="{{ item.thumbnail && item.thumbnail.url ? 'mt-8' : '' }} flex flex-wrap items-center gap-3 text-xs font-semibold text-ink-muted">
              <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('eventType', item.type) }}</span>
              <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('eventMode', item.mode) }}</span>
              @if(isPast)
                <span class="rounded-full bg-danger/10 px-3 py-1 text-danger">Sudah selesai</span>
              @end
            </div>

            <h1 class="mt-4 font-display font-extrabold text-3xl md:text-4xl leading-tight tracking-tight text-brand-navy">{{ item.title }}</h1>
            <p class="mt-4 text-lg leading-relaxed text-ink-muted">{{ item.summary }}</p>

            @if(item.description)
              <div class="mt-10">
                <h2 class="font-display font-bold text-2xl text-ink">Tentang Event Ini</h2>
                <div class="mt-4 leading-relaxed text-ink-muted [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{{ item.description }}}</div>
              </div>
            @end
          </div>

          <aside class="lg:sticky lg:top-24 rounded-2xl border border-border bg-white p-8 shadow-lg">
            <p class="text-sm text-ink-muted">Biaya</p>
            <p class="mt-1 font-mono text-3xl font-bold text-ink tabular-nums">{{ item.price > 0 ? formatRupiah(item.price) : 'Gratis' }}</p>

            <div class="mt-6 pt-6 border-t border-border flex flex-col gap-4 text-sm text-ink-muted">
              <p class="flex items-start gap-3"><span class="icon-[tabler--calendar-event] size-4 text-brand-blue shrink-0 mt-0.5"></span> {{ formatDate(item.startAt, 'full') }}</p>
              <p class="flex items-start gap-3"><span class="icon-[tabler--clock] size-4 text-brand-blue shrink-0 mt-0.5"></span> {{ eventTime(item.startAt, item.endAt) }}</p>
              <p class="flex items-start gap-3">
                @if(item.mode === 'ONLINE')
                  <span class="icon-[tabler--video] size-4 text-brand-blue shrink-0 mt-0.5"></span>
                @else
                  <span class="icon-[tabler--map-pin] size-4 text-brand-blue shrink-0 mt-0.5"></span>
                @end
                {{ optionLabel('eventMode', item.mode) }}{{ item.venue ? ' — ' + item.venue : '' }}
              </p>
              @if(item.quota)
                <p class="flex items-start gap-3"><span class="icon-[tabler--users] size-4 text-brand-blue shrink-0 mt-0.5"></span> Kuota {{ formatNumber(item.quota) }} peserta</p>
              @end
            </div>

            @if(isPast)
              <a href="/event" class="mt-6 flex items-center justify-center rounded-full border border-brand-blue px-6 py-3 text-sm font-semibold text-brand-blue transition-colors hover:bg-brand-blue hover:text-white">Lihat Jadwal Lainnya</a>
            @else
              <a href="{{ waLink(site.whatsapp, 'Halo Aloka, saya mau daftar ' + item.title) }}" class="mt-6 flex items-center justify-between gap-3 rounded-full bg-accent-amber pl-6 pr-2 py-2 text-sm font-semibold text-brand-navy transition-colors hover:bg-accent-amber-dark">
                Daftar Sekarang
                <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy">
                  <span class="icon-[tabler--arrow-right] size-4"></span>
                </span>
              </a>
            @end

            @if(item.facilitator && item.facilitator.slug)
              <a href="/fasilitator/{{ item.facilitator.slug }}" class="mt-6 pt-6 border-t border-border flex items-center gap-3">
                <span class="flex items-center justify-center size-11 rounded-full bg-brand-blue/10 text-brand-blue font-display font-bold shrink-0">
                  {{ item.facilitator.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() }}
                </span>
                <span>
                  <span class="block text-xs text-ink-muted">Pemateri</span>
                  <span class="block font-display font-semibold text-sm text-ink">{{ item.facilitator.name }}</span>
                </span>
              </a>
            @end
          </aside>
        </div>
      </div>
    </section>
  @end
@end
