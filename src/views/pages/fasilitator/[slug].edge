@let(found = await facilitator.read({ filters: { slug: params.slug, status: 'PUBLISH' }, limit: 1 }))
@let(item = found.data[0])
@if(!item)
  {{ abort(404) }}
@end
@let(site = await general.get())
@component('layouts/main', { request })
  @slot('title')
    {{ item.name }} — Fasilitator | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <a href="/fasilitator" class="hover:text-brand-blue transition-colors">Fasilitator</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">{{ item.name }}</span>
        </nav>

        <div class="mt-10 grid lg:grid-cols-3 gap-10 lg:gap-16 items-start">
          <div class="relative aspect-square rounded-2xl overflow-hidden bg-surface border border-border">
            @if(item.photo && item.photo.url)
              <img src="{{ imgOptimize(item.photo.url, { w: 800 }) }}" alt="{{ item.name }}" class="absolute inset-0 h-full w-full object-cover" />
            @else
              <span class="absolute inset-0 flex items-center justify-center font-display font-bold text-7xl text-brand-blue/30">
                {{ item.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() }}
              </span>
            @end
          </div>

          <div class="lg:col-span-2">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Fasilitator</span>
            <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">{{ item.name }}</h1>
            <p class="mt-3 text-lg text-ink-muted">{{ item.title }}</p>

            @if(item.city)
              <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted">
                <span class="icon-[tabler--map-pin] size-4 text-brand-blue"></span> {{ item.city }}
              </p>
            @end

            @if(item.expertise && item.expertise.length)
              <div class="mt-6 flex flex-wrap gap-2">
                @each(skill in item.expertise)
                  <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-brand-blue">{{ skill }}</span>
                @end
              </div>
            @end

            @if(item.bio)
              <div class="mt-8 leading-relaxed text-ink-muted [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{{ item.bio }}}</div>
            @end

            <a href="{{ waLink(site.whatsapp, 'Halo Aloka, saya mau konsultasi dengan ' + item.name) }}" class="mt-10 inline-flex items-center gap-3 rounded-full bg-accent-amber pl-6 pr-2 py-2 text-sm font-semibold text-brand-navy transition-colors hover:bg-accent-amber-dark">
              Konsultasi dengan {{ item.name.split(' ')[0] }}
              <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy">
                <span class="icon-[tabler--arrow-right] size-4"></span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  @end
@end
