@let(result = await facilitator.read({ filters: { status: 'PUBLISH' }, sort: 'sortOrder', order: 'asc', limit: 100 }))
@let(site = await general.get())
@component('layouts/main', { request })
  @slot('title')
    Fasilitator | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-20">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">Fasilitator</span>
        </nav>

        <div class="mt-8 max-w-2xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Tentang Kami</span>
          <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">
            Fasilitator &amp; Konsultan Aloka
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-ink-muted">
            Pelatih dan pendamping berpengalaman di bidang perkoperasian, keuangan, legalitas, dan pembiayaan — siap menemani koperasi Anda, online maupun langsung ke lokasi.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        @if(result.data.length)
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @each(item in result.data)
              <a href="/fasilitator/{{ item.slug }}" class="group flex flex-col rounded-2xl border border-border bg-white overflow-hidden shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
                <div class="relative aspect-square shrink-0 bg-surface">
                  @if(item.photo && item.photo.url)
                    <img src="{{ imgOptimize(item.photo.url, { w: 600 }) }}" alt="{{ item.name }}" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                  @else
                    <span class="absolute inset-0 flex items-center justify-center font-display font-bold text-5xl text-brand-blue/30">
                      {{ item.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() }}
                    </span>
                  @end
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="font-display font-semibold text-lg text-ink">{{ item.name }}</h3>
                  <p class="mt-1 text-sm text-ink-muted">{{ item.title }}</p>
                  @if(item.expertise && item.expertise.length)
                    <div class="mt-4 flex flex-wrap gap-2 flex-1 content-start">
                      @each(skill in item.expertise.slice(0, 3))
                        <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-brand-blue">{{ skill }}</span>
                      @end
                    </div>
                  @end
                  <div class="mt-4 pt-4 border-t border-border flex items-center justify-between text-xs font-semibold text-ink-muted">
                    <span class="flex items-center gap-1">
                      @if(item.city)
                        <span class="icon-[tabler--map-pin] size-3.5"></span> {{ item.city }}
                      @end
                    </span>
                    <span class="icon-[tabler--arrow-right] size-4 text-brand-blue transition-transform duration-300 group-hover:translate-x-1"></span>
                  </div>
                </div>
              </a>
            @end
          </div>
        @else
          <div class="rounded-2xl border border-border bg-surface p-10 text-center">
            <span class="icon-[tabler--users-group] size-8 text-brand-blue"></span>
            <p class="mt-4 font-display font-semibold text-lg text-ink">Profil fasilitator segera hadir</p>
            <p class="mt-2 text-sm text-ink-muted">Ingin tahu lebih lanjut soal tim kami? Tanyakan langsung lewat WhatsApp.</p>
          </div>
        @end
      </div>
    </section>

    @component('components/closing-cta', {
      eyebrow: 'Butuh Pendamping?',
      body: 'Ceritakan kebutuhan koperasi Anda — kami carikan fasilitator yang paling sesuai.',
      primaryLabel: 'Konsultasi Gratis',
      primaryHref: waLink(site.whatsapp, 'Halo Aloka, saya mau konsultasi dengan fasilitator'),
      secondaryLabel: 'Lihat Layanan Konsultasi',
      secondaryHref: '/konsultasi'
    })
      @slot('icon')
        <span class="icon-[tabler--users-group] size-4"></span>
      @end
      @slot('heading')
        Temukan Pendamping yang <span class="text-accent-amber">Tepat</span>
      @end
    @end
  @end
@end
