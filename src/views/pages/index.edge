          <a href="/event/try-out-sertifikasi-kompetensi-aloka-batch-3" class="group flex flex-col sm:flex-row sm:items-center gap-5 p-6 md:p-8 transition-colors hover:bg-surface">
            <div class="flex items-center justify-center rounded-2xl bg-brand-navy text-white size-16 shrink-0">
              <div class="text-center">
                <p class="font-mono text-xl font-bold leading-none tabular-nums">18</p>
