            <div class="flex-1">
              <h3 class="font-display font-semibold text-lg text-ink">Try Out Sertifikasi Kompetensi Aloka Batch 3</h3>
              <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-muted">
                <span class="icon-[tabler--video] size-4"></span>
