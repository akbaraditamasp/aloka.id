@let(site = await general.get())
@component('layouts/main', { request })
  @slot('title')
    Aloka — Koperasi Naik Kelas, Bareng Aloka
  @end

  @slot('main')
    @let(stat = await stats.get())
    @let(upcomingEvents = (await event.read({ filters: { status: 'PUBLISH', startAt: { $gte: new Date().toISOString() } }, sort: 'startAt', order: 'asc', limit: 3, populate: 'none' })).data)
    @let(coursePool = (await course.read({ filters: { status: 'PUBLISH' }, sort: 'sortOrder', order: 'asc', limit: 30 })).data)
    @let(featuredCourses = coursePool.filter((c) => c.featured === 'YES'))
    @let(popularCourses = (featuredCourses.length ? featuredCourses : coursePool).slice(0, 3))
    @let(subIcons = [{ icon: 'icon-[ph--chart-line-up-duotone]', box: 'bg-success/10 text-success' }, { icon: 'icon-[ph--gavel-duotone]', box: 'bg-accent-amber/10 text-accent-amber-dark' }])
    {{-- Badge classes are literal strings here (not built from a prop) so Tailwind's scanner sees them. --}}
    @let(badges = ['bg-brand-blue/10 text-brand-blue', 'bg-success/10 text-success', 'bg-accent-amber/10 text-accent-amber-dark'])
    @let(testimonialResult = await testimonial.read({ filters: { status: 'PUBLISH' }, sort: 'sortOrder', order: 'asc', limit: 12, populate: 'none' }))
    @let(items = testimonialResult.data.map((t, i) => ({ initials: t.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase(), name: t.name, role: t.position + ', ' + t.organization, badge: badges[i % badges.length], quote: t.quote })))
    <section class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <div>
            <div class="mt-4 flex items-center gap-2.5">
              <span class="h-3.5 w-1 rounded-full shrink-0" style="background: linear-gradient(180deg, #00ADEE 0%, #242A6A 100%);"></span>
              <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Konsultan &amp; Edukasi Koperasi</span>
            </div>

            <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl lg:text-[3.4rem] leading-tight tracking-tight text-ink">
              Koperasi
              <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">Naik Kelas</span>,
              Bareng Aloka
            </h1>

            <p class="mt-3 font-display font-semibold text-xl md:text-2xl text-brand-blue">
              Lebih Objektif, Kredibel &amp; Akuntabel
            </p>

            <p class="mt-6 text-lg leading-relaxed text-ink-muted max-w-xl">
              Dari kelas online dan sertifikasi, konsultasi dengan pendamping bersertifikat, sampai pengurusan legalitas dan akses pembiayaan — Aloka menemani koperasi Anda di setiap langkah, online maupun langsung ke lokasi.
            </p>

            <div class="mt-8 flex flex-col items-start sm:flex-row sm:flex-wrap sm:items-center gap-4 sm:gap-5">
              {{-- Colored shadow (brand-blue/navy, not black) matches STYLE.md §5's shadow guidance; the two-stop
                   hover shadow is a one-off drama effect for the primary hero CTA, not a reusable token. --}}
              <a href="/konsultasi" class="group inline-flex items-center gap-3 rounded-full pl-6 pr-2 py-2 text-sm font-semibold text-white shadow-[0_15px_35px_-10px_rgba(19,105,169,0.55)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_22px_45px_-12px_rgba(0,173,238,0.6)]" style="background: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">
                Konsultasi Gratis
                <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy transition-transform duration-300 group-hover:translate-x-1">
                  <span class="icon-[tabler--arrow-right] size-4"></span>
                </span>
              </a>
              {{-- Small left inset on mobile roughly lines this link's text up with the primary button's
                   text above — reset to 0 once they sit side by side at sm+. --}}
              <a href="/kelas-elearning" class="inline-flex items-center gap-1.5 pl-3 sm:pl-0 mt-1 sm:mt-0 text-sm font-semibold text-brand-blue hover:text-brand-indigo transition-colors">
                Jelajahi Kelas Akademi
                <span class="icon-[tabler--arrow-right] size-4"></span>
              </a>
            </div>

            <div class="mt-12">
              <p class="text-sm font-medium text-ink-muted mb-5">Dipercaya oleh koperasi di seluruh Indonesia</p>
              {{-- Icon sits above the number on mobile (stacked, centered) so all three points still fit
                   in one horizontal row on narrow screens; from sm: it reverts to icon-beside-text. --}}
              <div class="flex divide-x divide-border">
                <div class="flex-1 flex flex-col items-center text-center gap-2 pr-3 sm:flex-none sm:flex-row sm:items-center sm:text-left sm:gap-3 sm:pr-6">
                  <span class="flex items-center justify-center size-10 sm:size-11 rounded-xl bg-brand-blue/10 text-brand-blue shrink-0">
                    <span class="icon-[tabler--building-community] size-5"></span>
                  </span>
                  <div>
                    <p class="font-mono text-base sm:text-lg font-bold text-ink tabular-nums leading-tight">{{ formatNumber(stat.cooperatives) }}+</p>
                    <p class="text-xs text-ink-muted whitespace-nowrap">Koperasi Dibina</p>
                  </div>
                </div>
                <div class="flex-1 flex flex-col items-center text-center gap-2 px-3 sm:flex-none sm:flex-row sm:items-center sm:text-left sm:gap-3 sm:px-6">
                  <span class="flex items-center justify-center size-10 sm:size-11 rounded-xl bg-success/10 text-success shrink-0">
                    <span class="icon-[tabler--users] size-5"></span>
                  </span>
                  <div>
                    <p class="font-mono text-base sm:text-lg font-bold text-ink tabular-nums leading-tight">{{ formatNumber(stat.participants) }}+</p>
                    <p class="text-xs text-ink-muted whitespace-nowrap">Peserta Terlatih</p>
                  </div>
                </div>
                <div class="flex-1 flex flex-col items-center text-center gap-2 pl-3 sm:flex-none sm:flex-row sm:items-center sm:text-left sm:gap-3 sm:pl-6">
                  <span class="flex items-center justify-center size-10 sm:size-11 rounded-xl bg-accent-amber/10 text-accent-amber-dark shrink-0">
                    <span class="icon-[tabler--award] size-5"></span>
                  </span>
                  <div>
                    <p class="font-mono text-base sm:text-lg font-bold text-ink tabular-nums leading-tight">{{ formatNumber(stat.facilitators) }}+</p>
                    <p class="text-xs text-ink-muted whitespace-nowrap">Fasilitator Aktif</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="relative lg:-mt-6">
            {{-- Slightly taller than square so more of the subject's lower body shows without cropping
                 the head — a one-off ratio tuned for this photo, not a reusable token. --}}
            <div class="relative aspect-[6/7] rounded-2xl overflow-hidden" style="background: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">
              <img src="{{ vite.static('hero.png') }}" alt="Konsultan Aloka" class="absolute inset-0 w-full h-full object-cover object-[center_18%]" />

              {{-- Only this ornament should bleed past the panel edge — overflow-hidden lives on this
                   panel div specifically so the floating cards below (outside this div) stay uncropped. --}}
              <img src="{{ vite.static('ornament-hero-abstract.svg') }}" alt="" class="pointer-events-none select-none absolute -top-16 -right-16 md:-top-20 md:-right-20 w-80 md:w-96" />
            </div>

            {{-- Hidden below lg: on the stacked mobile layout the panel is narrower/proportionally taller,
                 so both cards together would creep up over the model's face. Keep just the chat card there. --}}
            <div class="hidden lg:block absolute -left-4 bottom-36 md:-left-10 md:bottom-40 w-64 rounded-2xl bg-white p-5 shadow-lg border border-border">
              <p class="text-sm font-semibold text-ink mb-4">Skor Kesehatan Koperasi</p>
              <div class="space-y-3">
                <div>
                  <div class="flex items-center justify-between text-xs text-ink-muted mb-1">
                    <span>Legalitas</span>
                    <span class="font-mono">90%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-surface overflow-hidden">
                    <div class="h-full w-[90%] rounded-full bg-brand-blue"></div>
                  </div>
                </div>
                <div>
                  <div class="flex items-center justify-between text-xs text-ink-muted mb-1">
                    <span>Keuangan</span>
                    <span class="font-mono">78%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-surface overflow-hidden">
                    <div class="h-full w-[78%] rounded-full bg-success"></div>
                  </div>
                </div>
                <div>
                  <div class="flex items-center justify-between text-xs text-ink-muted mb-1">
                    <span>Kelembagaan</span>
                    <span class="font-mono">85%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-surface overflow-hidden">
                    <div class="h-full w-[85%] rounded-full bg-brand-sky"></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="absolute -right-4 bottom-8 md:-right-8 w-72 rounded-2xl bg-brand-navy p-5 shadow-lg">
              <div class="flex items-start gap-2.5">
                <span class="icon-[tabler--message-circle-2] size-5 text-brand-sky-200 shrink-0 mt-0.5"></span>
                <p class="text-sm text-white/90 leading-relaxed">
                  "Koperasi kami mau urus izin USP tapi belum tahu mulai dari mana..."
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden py-16 md:py-24 bg-surface">
      <img src="{{ vite.static('ornament-pilar-blob.svg') }}" alt="" class="pointer-events-none select-none absolute -top-16 -right-16 md:-top-20 md:-right-20 w-80 md:w-96" />

      <div class="relative max-w-7xl mx-auto px-4 md:px-6">
        <div class="max-w-2xl">
          {{-- Dropped the hardcoded "6 Layanan Utama" label — the pillar count has already
               changed once (now 8 pages incl. Konsultan Pajak and Laporan Keuangan) and will keep moving as new
               pillars are added, so the eyebrow stays a plain category label instead. --}}
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Layanan Utama</span>
          <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">
            Satu Platform,
            <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">Semua Kebutuhan Koperasi</span>
            Anda
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-muted">
            Dari kelas online dan sertifikasi, konsultasi tata kelola, legalitas dan perizinan, akses pembiayaan, konsultan pajak, sampai laporan keuangan — semua tersedia di Aloka.
          </p>
        </div>

        <div class="mt-12 grid md:grid-cols-3 gap-6">
          <a href="/kelas-elearning" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-brand-blue/10 text-brand-blue">
              <span class="icon-[ph--graduation-cap-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Kelas E-Learning</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              Kelas online pelatihan perkoperasian dari dasar sampai lanjutan — belajar mandiri sesuai ritme Anda, dapatkan sertifikat setelah selesai.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Jelajahi Kelas
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>

          <a href="/konsultasi" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-success/10 text-success">
              <span class="icon-[ph--chats-circle-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Konsultasi</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              ART, Persus, SOP, sampai pendampingan pelaporan RAT — didampingi konsultan berpengalaman, bukan sekadar diajari.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Lihat Layanan Konsultasi
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>

          <a href="/legalitas" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-accent-amber/10 text-accent-amber-dark">
              <span class="icon-[ph--scales-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Legalitas</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              Pendirian badan hukum koperasi dari nol — akta, SK Kemenkumham, sampai NIB — didampingi tim yang paham prosesnya luar-dalam.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Cek Layanan Legalitas
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>

          <a href="/izin-ksp-usp" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-brand-navy/10 text-brand-navy">
              <span class="icon-[ph--shield-check-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Izin KSP/USP</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              Uji Kepatutan &amp; Kelayakan pengurus, SLIK OJK/BI Checking, sampai surat keterangan tidak pailit — lengkap syarat kelayakan izin operasional Anda.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Urus Izin KSP/USP
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>

          <a href="/pembiayaan" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-brand-indigo/10 text-brand-indigo">
              <span class="icon-[ph--hand-coins-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Pembiayaan</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              Pendampingan pengajuan pembiayaan ke bank, KUR, sampai LPDB-KUMKM dengan fee flat per paket — bukan success fee.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Ajukan Pendampingan Pembiayaan
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>

          <a href="/sertifikasi-bnsp" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
            <span class="flex items-center justify-center size-12 rounded-xl bg-brand-blue/10 text-brand-blue">
              <span class="icon-[ph--certificate-duotone] size-6"></span>
            </span>
            <h3 class="mt-6 font-display font-semibold text-xl text-ink">Sertifikasi BNSP</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted flex-1">
              Buktikan kompetensi pengurus lewat Sertifikasi Kompetensi BNSP, resmi berbasis standar nasional, lengkap dengan try out sebelum ujian.
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue group-hover:text-brand-indigo transition-colors">
              Lihat Sertifikasi BNSP
              <span class="icon-[tabler--arrow-right] size-4 transition-transform duration-300 group-hover:translate-x-1"></span>
            </span>
          </a>
        </div>

        {{-- Konsultan Pajak (7th) and Laporan Keuangan (8th) are newer pillars, not part of the
             original 6. Rather than force them into orphan slots in the 3-col grid above, they
             share a 2-col banner row so the "new" positioning reads as deliberate. --}}
        <div class="mt-6 grid md:grid-cols-2 gap-6">
          <a href="/konsultan-pajak" class="group flex flex-col gap-6 rounded-2xl bg-brand-navy p-8 shadow-sm transition-all duration-300 hover:shadow-xl">
            <span class="flex items-center justify-center size-14 rounded-xl bg-white/10 text-brand-sky shrink-0">
              <span class="icon-[tabler--calculator] size-7"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2.5">
                <h3 class="font-display font-semibold text-xl text-white">Konsultan Pajak</h3>
                <span class="rounded-full bg-accent-amber px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-brand-navy">Baru</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-white/70">
                Pelaporan pajak tahunan, konsultasi pajak SHU, PPN unit usaha, sampai pendampingan pemeriksaan pajak koperasi.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-white">
              Konsultasi Pajak Gratis
              <span class="flex items-center justify-center size-8 rounded-full bg-accent-amber text-brand-navy transition-transform duration-300 group-hover:translate-x-1">
                <span class="icon-[tabler--arrow-right] size-4"></span>
              </span>
            </span>
          </a>

          <a href="/laporan-keuangan" class="group flex flex-col gap-6 rounded-2xl bg-brand-navy p-8 shadow-sm transition-all duration-300 hover:shadow-xl">
            <span class="flex items-center justify-center size-14 rounded-xl bg-white/10 text-brand-sky shrink-0">
              <span class="icon-[tabler--chart-bar] size-7"></span>
            </span>
            <div class="flex-1">
              <div class="flex items-center gap-2.5">
                <h3 class="font-display font-semibold text-xl text-white">Laporan Keuangan</h3>
                <span class="rounded-full bg-accent-amber px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-brand-navy">Baru</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-white/70">
                Pembukuan bulanan, laporan keuangan tahunan, sampai perhitungan SHU — siap untuk RAT, pembiayaan, dan pemeriksaan.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-white">
              Konsultasi Laporan Keuangan
              <span class="flex items-center justify-center size-8 rounded-full bg-accent-amber text-brand-navy transition-transform duration-300 group-hover:translate-x-1">
                <span class="icon-[tabler--arrow-right] size-4"></span>
              </span>
            </span>
          </a>
        </div>
      </div>
    </section>

    @if(popularCourses.length)
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="max-w-2xl">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Akademi</span>
            <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">Kelas Populer Minggu Ini</h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-muted">
              Belajar perkoperasian sesuai ritme Anda — tonton kapan saja, dapatkan sertifikat setelah selesai.
            </p>
          </div>
          <a href="/kelas-elearning" class="shrink-0 inline-flex items-center gap-1.5 self-start md:self-auto rounded-full border border-brand-blue px-6 py-3 text-sm font-semibold text-brand-blue transition-colors hover:bg-brand-blue hover:text-white">
            Lihat Semua Kelas
            <span class="icon-[tabler--arrow-right] size-4"></span>
          </a>
        </div>

        <div class="mt-12 grid md:grid-cols-12 gap-6">
          {{-- Featured card: bigger and full-column-height, deliberately unlike the two smaller
               cards stacked beside it. The 6/6 split (one wide card vs. an evenly aligned stack)
               is the asymmetry — not a repeat of the equal-width pilar grid above. --}}
          @let(main = popularCourses[0])
          <a href="/kelas-elearning/{{ main.slug }}" class="group md:col-span-6 flex flex-col rounded-2xl border border-white/10 bg-brand-navy overflow-hidden shadow-sm transition-all duration-300 hover:shadow-xl md:h-full">
            <div class="relative aspect-video shrink-0">
              @if(main.thumbnail && main.thumbnail.url)
                <img src="{{ imgOptimize(main.thumbnail.url, { w: 800 }) }}" alt="" class="absolute inset-0 h-full w-full object-cover" />
              @else
                <img src="{{ vite.static('akademi-1.jpg') }}" alt="" class="absolute inset-0 h-full w-full object-cover" />
              @end
              {{-- Thin blue (primary) tint over the photo, per request — multiply keeps photo detail
                   instead of washing it out with a flat color block. --}}
              <div class="absolute inset-0 bg-brand-blue/15 mix-blend-multiply"></div>
              <div class="absolute top-4 left-4 flex items-center gap-3">
                <span class="flex items-center justify-center size-11 rounded-xl bg-white text-brand-blue shadow-sm shrink-0">
                  <span class="icon-[ph--graduation-cap-duotone] size-6"></span>
                </span>
                <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-blue shadow-sm">{{ optionLabel('courseCategory', main.category) }}</span>
              </div>
            </div>
            <div class="p-8 flex flex-col flex-1">
              <h3 class="font-display font-bold text-2xl text-white leading-tight">{{ main.title }}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70 flex-1">{{ main.summary }}</p>
              <div class="mt-6 flex items-center justify-between">
                <div class="flex items-center gap-3 text-xs font-semibold text-white/70">
                  <span class="rounded-full bg-white/15 px-3 py-1 text-white">{{ optionLabel('courseLevel', main.level) }}</span>
                  <span class="flex items-center gap-1">
                    <span class="icon-[tabler--clock] size-3.5"></span>
                    {{ main.durationMinutes }} Menit
                  </span>
                </div>
                <span class="flex items-center justify-center size-10 rounded-full bg-accent-amber text-brand-navy transition-transform duration-300 group-hover:translate-x-1">
                  <span class="icon-[tabler--arrow-right] size-4"></span>
                </span>
              </div>
            </div>
          </a>

          {{-- Mobile: cards stack full-width (flex-col), not a 2-column grid — squeezing these into
               half-width columns left no room for the meta row (level + duration + arrow), so the
               arrow wrapped onto its own line. Desktop stack (md:grid-cols-1) unchanged. --}}
          @if(popularCourses.length > 1)
            <div class="md:col-span-6 flex flex-col md:grid md:grid-cols-1 gap-6">
              @each((sub, i) in popularCourses.slice(1))
                <a href="/kelas-elearning/{{ sub.slug }}" class="group relative overflow-hidden flex flex-col rounded-2xl border border-border bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
                  {{-- Photo fades in only at the top-right corner via a radial mask, then dissolves to
                       transparent toward the bottom-left — a thin accent, not a full photo background. --}}
                  <img src="{{ sub.thumbnail && sub.thumbnail.url ? imgOptimize(sub.thumbnail.url, { w: 600 }) : vite.static('akademi-' + (i + 2) + '.jpg') }}" alt="" class="pointer-events-none select-none absolute inset-0 h-full w-full object-cover opacity-40" style="mask-image: radial-gradient(circle at top right, black 0%, transparent 60%); -webkit-mask-image: radial-gradient(circle at top right, black 0%, transparent 60%);" />
                  <div class="relative flex items-center gap-3">
                    <span class="flex items-center justify-center size-11 rounded-xl shrink-0 {{ subIcons[i % subIcons.length].box }}">
                      <span class="{{ subIcons[i % subIcons.length].icon }} size-6"></span>
                    </span>
                    <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-brand-blue">{{ optionLabel('courseCategory', sub.category) }}</span>
                  </div>
                  <h3 class="relative mt-3 md:mt-auto font-display font-semibold text-lg text-ink">{{ sub.title }}</h3>
                  <p class="relative mt-2 text-sm leading-relaxed text-ink-muted">{{ sub.summary }}</p>
                  <div class="relative mt-5 flex items-center justify-between">
                    <div class="flex items-center gap-3 text-xs font-semibold text-ink-muted">
                      <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('courseLevel', sub.level) }}</span>
                      <span class="flex items-center gap-1">
                        <span class="icon-[tabler--clock] size-3.5"></span>
                        {{ sub.durationMinutes }} Menit
                      </span>
                    </div>
                    <span class="icon-[tabler--arrow-right] size-4 text-brand-blue transition-transform duration-300 group-hover:translate-x-1"></span>
                  </div>
                </a>
              @end
            </div>
          @end
        </div>
      </div>
    </section>
    @end

    @if(items.length)
    <section class="relative py-16 md:py-24 bg-surface overflow-hidden">
      {{-- Same low-opacity brand-gradient treatment as the pilar section's ornament (two overlapping
           shapes), but tilted rounded squares instead of circles, so the two sections don't feel
           like copies. --}}
      <div class="pointer-events-none select-none absolute -top-10 -right-10 md:-top-14 md:-right-14 w-56 h-56 md:w-72 md:h-72 rounded-[2.5rem] rotate-12 opacity-10" style="background: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);"></div>
      <div class="pointer-events-none select-none absolute -top-4 -right-4 md:-top-6 md:-right-6 w-36 h-36 md:w-48 md:h-48 rounded-[2rem] -rotate-6 opacity-10" style="background: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);"></div>

      <div class="relative max-w-7xl mx-auto px-4 md:px-6">
        <div class="max-w-2xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Testimoni</span>
          <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">
            Dipercaya Pengurus Koperasi
            <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">di Seluruh Indonesia</span>
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-muted">
            Cerita langsung dari pengurus koperasi yang sudah naik kelas bareng Aloka.
          </p>
        </div>
      </div>

      {{-- Row positions never move — the main slot is always taller/highlighted and flush with the
           headline's left edge, the rest trail rightward at fixed width until the section's own edge
           (`overflow-hidden` above) crops them. Only which testimonial fills each fixed slot crossfades
           on tick, so nothing shifts/blinks. --}}
      <div
        x-data="{ active: 0, items: {{ JSON.stringify(items) }} }"
        x-init="setInterval(() => active = (active + 1) % items.length, 5000)"
        class="mt-12"
      >
        <div class="max-w-7xl mx-auto pl-4 md:pl-6">
          <div class="flex items-center gap-6">
            {{-- Main slot: taller, highlighted, flush left with the headline above. --}}
            <div class="relative w-80 md:w-96 h-80 shrink-0">
              <template x-for="(t, i) in items" :key="'main-' + i">
                <div
                  x-show="i === active"
                  x-transition:enter="transition ease-out duration-500"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end="opacity-100"
                  x-transition:leave="transition ease-in duration-300"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  class="absolute inset-0 flex flex-col rounded-2xl border border-brand-blue/30 bg-gradient-to-br from-brand-sky/10 via-white to-white p-8 shadow-lg"
                >
                  <span class="icon-[tabler--quote] size-8 text-brand-blue/20"></span>
                  <p class="mt-4 text-sm leading-relaxed text-ink-muted line-clamp-5 flex-1" x-text="t.quote"></p>
                  <div class="mt-6 pt-6 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-11 rounded-full font-display font-bold shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            {{-- Trailing slots: same size, plain white, just line up to the right — the section's
                 overflow-hidden crops however many don't fit instead of wrapping or scrolling. --}}
            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'next-' + i">
                <div x-show="i === (active + 1) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'after-' + i">
                <div x-show="i === (active + 2) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot3-' + i">
                <div x-show="i === (active + 3) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot4-' + i">
                <div x-show="i === (active + 4) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot5-' + i">
                <div x-show="i === (active + 5) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            {{-- Spare trailing block so the crop reads as "more cards run off-page", not a hard stop
                 right after the last real slot. --}}
            <div class="w-72 h-64 shrink-0 rounded-2xl border border-border bg-white/60"></div>
          </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 md:px-6">
          <div class="mt-8 ml-1 flex items-center justify-start gap-2">
            <template x-for="(t, i) in items" :key="'dot-' + i">
              <button @click="active = i" :class="active === i ? 'w-6 bg-brand-blue' : 'w-2 bg-border'" class="h-2 rounded-full transition-all duration-300" aria-label="Lihat testimoni"></button>
            </template>
          </div>
        </div>
      </div>
    </section>
    @end

    @if(upcomingEvents.length)
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="max-w-2xl">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Event</span>
            <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">
              Jadwal Pelatihan &amp;
              <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">Webinar Terdekat</span>
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-muted">
              Ikut langsung, online maupun tatap muka — kuota terbatas tiap sesi.
            </p>
          </div>
          <a href="/event" class="shrink-0 inline-flex items-center gap-1.5 self-start md:self-auto rounded-full border border-brand-blue px-6 py-3 text-sm font-semibold text-brand-blue transition-colors hover:bg-brand-blue hover:text-white">
            Lihat Semua Event
            <span class="icon-[tabler--arrow-right] size-4"></span>
          </a>
        </div>

        <div class="mt-12 flex flex-col divide-y divide-border rounded-2xl border border-border bg-white">
          @each(item in upcomingEvents)
            @!component('components/event-row', { item })
          @end
        </div>
      </div>
    </section>
    @end

    @component('components/closing-cta', {
      eyebrow: 'Mulai Sekarang',
      body: 'Konsultasi gratis dengan pendamping bersertifikat Aloka — tanpa komitmen, tanpa biaya di awal.',
      primaryHref: waLink(site.whatsapp, 'Halo Aloka, saya mau konsultasi'),
      primaryLabel: 'Konsultasi Gratis',
      secondaryHref: '/kelas-elearning',
      secondaryLabel: 'Jelajahi Kelas E-Learning',
    })
      @slot('icon')
        <span class="icon-[tabler--rocket] size-4"></span>
      @end
      @slot('heading')
        Siap Bawa Koperasi Anda <span class="text-accent-amber">Naik Kelas</span>?
      @end
    @end
  @end
@end
