        <div class="mt-12 flex flex-col divide-y divide-border rounded-2xl border border-border bg-white">
          <a href="/event/webinar-strategi-legalitas-ksp-usp-2026" class="group flex flex-col sm:flex-row sm:items-center gap-5 p-6 md:p-8 transition-colors hover:bg-surface">
            <div class="flex items-center justify-center rounded-2xl bg-brand-navy text-white size-16 shrink-0">
              <div class="text-center">
                <p class="font-mono text-xl font-bold leading-none tabular-nums">20</p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-white/70">Sep</p>
