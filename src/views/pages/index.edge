            { initials: "SR", name: "Siti Rahma", role: "Bendahara, Koperasi Sejahtera Bersama — Lampung", badge: "bg-success/10 text-success", quote: "Kelas akuntansi & laporan keuangannya gampang diikuti walau saya bukan lulusan akuntansi. Sekarang neraca dan pembagian SHU koperasi kami rapi dan bisa dipertanggungjawabkan ke anggota." },
            { initials: "AP", name: "Andi Prasetyo", role: "Pengurus, KSP Amanah — Yogyakarta", badge: "bg-accent-amber/10 text-accent-amber-dark", quote: "Konsultan Aloka datang langsung ke koperasi kami buat pendampingan pengajuan pembiayaan. Fee-nya jelas di depan, tidak ada potongan hasil, dan pengajuan kami akhirnya disetujui bank." },
            { initials: "RW", name: "Rina Wulandari", role: "Ketua, Koperasi Wanita Mandiri — Bali", badge: "bg-brand-blue/10 text-brand-blue", quote: "Ikut kelas online dan sertifikasi kompetensi Aloka bikin saya lebih percaya diri ngurus koperasi. Materinya jelas, bisa diulang kapan saja, dan sertifikatnya diakui pas kami ajukan izin operasional." },
            { initials: "HG", name: "Hendra Gunawan", role: "Ketua, Koperasi Nelayan Bahari — Sulawesi Selatan", badge: "bg-success/10 text-success", quote: "Kami mendirikan koperasi dari nol dan sama sekali buta soal akta sama NIB. Tim Aloka pandu step by step sampai badan hukum kami resmi terbit." },
            { initials: "DL", name: "Dewi Lestari", role: "Sekretaris, Koperasi Konsumen Sejahtera — Sumatera Utara", badge: "bg-accent-amber/10 text-accent-amber-dark", quote: "Webinar rutin Aloka selalu ada insight baru buat pengurus kayak saya. Enak juga bisa langsung tanya ke fasilitatornya kalau ada yang belum paham." }
          ]
        }'
        x-init="setInterval(() => active = (active + 1) % items.length, 5000)"
        class="mt-12"
      >
        <div class="max-w-7xl mx-auto pl-4 md:pl-6">
          <div class="flex items-center gap-6">
            {{-- Main slot: taller, highlighted, flush left with the headline above. --}}
            <div class="relative w-80 md:w-96 h-80 shrink-0">
              <template x-for="(t, i) in items" :key="'main-' + i">
                <div
                  x-show="i === active"
                  x-transition:enter="transition ease-out duration-500"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end="opacity-100"
                  x-transition:leave="transition ease-in duration-300"
                  x-transition:leave-start="opacity-100"
                  x-transition:leave-end="opacity-0"
                  class="absolute inset-0 flex flex-col rounded-2xl border border-brand-blue/30 bg-gradient-to-br from-brand-sky/10 via-white to-white p-8 shadow-lg"
                >
                  <span class="icon-[tabler--quote] size-8 text-brand-blue/20"></span>
                  <p class="mt-4 text-sm leading-relaxed text-ink-muted line-clamp-5 flex-1" x-text="t.quote"></p>
                  <div class="mt-6 pt-6 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-11 rounded-full font-display font-bold shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            {{-- Trailing slots: same size, plain white, just line up to the right — the section's
                 overflow-hidden crops however many don't fit instead of wrapping or scrolling. --}}
            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'next-' + i">
                <div x-show="i === (active + 1) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'after-' + i">
                <div x-show="i === (active + 2) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot3-' + i">
                <div x-show="i === (active + 3) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot4-' + i">
                <div x-show="i === (active + 4) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div class="relative w-72 h-64 shrink-0">
              <template x-for="(t, i) in items" :key="'slot5-' + i">
                <div x-show="i === (active + 5) % items.length" class="absolute inset-0 flex flex-col rounded-2xl border border-border bg-white p-7 shadow-sm">
                  <span class="icon-[tabler--quote] size-7 text-brand-blue/20"></span>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted line-clamp-4 flex-1" x-text="t.quote"></p>
                  <div class="mt-5 pt-5 border-t border-border flex items-center gap-3">
                    <span class="flex items-center justify-center size-10 rounded-full font-display font-bold text-sm shrink-0" :class="t.badge" x-text="t.initials"></span>
                    <div>
                      <p class="font-display font-semibold text-sm text-ink" x-text="t.name"></p>
                      <p class="text-xs text-ink-muted" x-text="t.role"></p>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            {{-- Spare trailing block so the crop reads as "more cards run off-page", not a hard stop
                 right after the last real slot. --}}
            <div class="w-72 h-64 shrink-0 rounded-2xl border border-border bg-white/60"></div>
          </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 md:px-6">
          <div class="mt-8 ml-1 flex items-center justify-start gap-2">
            <template x-for="(t, i) in items" :key="'dot-' + i">
              <button @click="active = i" :class="active === i ? 'w-6 bg-brand-blue' : 'w-2 bg-border'" class="h-2 rounded-full transition-all duration-300" aria-label="Lihat testimoni"></button>
            </template>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="max-w-2xl">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Event</span>
            <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">
              Jadwal Pelatihan &amp;
              <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">Webinar Terdekat</span>
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-muted">
              Ikut langsung, online maupun tatap muka — kuota terbatas tiap sesi.
