@let(currentPage = Math.max(1, Number(query.page) || 1))
@let(result = await course.read({ filters: { status: 'PUBLISH' }, sort: 'sortOrder', order: 'asc', page: currentPage, limit: 9 }))
@component('layouts/main', { request })
  @slot('title')
    Kelas E-Learning Perkoperasian | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-10 md:pb-12">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">Kelas E-Learning</span>
        </nav>

        <div class="mt-8 max-w-2xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Akademi</span>
          <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">
            Kelas E-Learning Perkoperasian
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-ink-muted">
            Belajar tata kelola, keuangan, legalitas, sampai digitalisasi koperasi — tonton kapan saja sesuai ritme Anda, dapatkan sertifikat setelah selesai.
          </p>
        </div>
      </div>
    </section>

    @!component('components/course-catalog', { activeCategory: null, result, basePath: '/kelas-elearning' })

    @component('components/closing-cta', {
      eyebrow: 'Belajar, Lalu Bersertifikat',
      body: 'Buktikan kompetensi Anda lewat Sertifikasi Kompetensi BNSP setelah menyelesaikan kelas yang relevan.',
      primaryHref: '/sertifikasi-bnsp',
      primaryLabel: 'Lihat Sertifikasi BNSP',
      secondaryHref: '/',
      secondaryLabel: 'Kembali ke Beranda',
    })
      @slot('icon')
        <span class="icon-[tabler--certificate] size-4"></span>
      @end
      @slot('heading')
        Sudah Selesai Kelas? Lanjut Uji Kompetensi BNSP
      @end
    @end
  @end
@end
