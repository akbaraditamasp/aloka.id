@let(found = await course.read({ filters: { slug: params.slug, status: 'PUBLISH' }, limit: 1 }))
@let(item = found.data[0])
@if(!item)
  {{ abort(404) }}
@end
@let(site = await general.get())
@component('layouts/main', { request, description: item.summary })
  @slot('title')
    {{ item.title }} | Kelas E-Learning Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <a href="/kelas-elearning" class="hover:text-brand-blue transition-colors">Kelas E-Learning</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">{{ item.title }}</span>
        </nav>

        <div class="mt-10 grid lg:grid-cols-3 gap-10 lg:gap-16 items-start">
          <div class="lg:col-span-2">
            <div class="relative aspect-video rounded-2xl overflow-hidden bg-surface border border-border">
              @if(item.thumbnail && item.thumbnail.url)
                <img src="{{ imgOptimize(item.thumbnail.url, { w: 1200 }) }}" alt="{{ item.title }}" class="absolute inset-0 h-full w-full object-cover" />
              @else
                <img src="{{ vite.static('akademi-1.jpg') }}" alt="" class="absolute inset-0 h-full w-full object-cover" />
              @end
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-3 text-xs font-semibold text-ink-muted">
              <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('courseCategory', item.category) }}</span>
              <span class="rounded-full bg-surface px-3 py-1 text-brand-blue">{{ optionLabel('courseLevel', item.level) }}</span>
              <span class="flex items-center gap-1"><span class="icon-[tabler--clock] size-3.5"></span> {{ item.durationMinutes }} Menit</span>
            </div>

            <h1 class="mt-4 font-display font-extrabold text-3xl md:text-4xl leading-tight tracking-tight text-brand-navy">{{ item.title }}</h1>
            <p class="mt-4 text-lg leading-relaxed text-ink-muted">{{ item.summary }}</p>

            @if(item.outcomes && item.outcomes.length)
              <div class="mt-10">
                <h2 class="font-display font-bold text-2xl text-ink">Yang Akan Anda Pelajari</h2>
                <div class="mt-5 flex flex-col gap-3">
                  @each(point in item.outcomes)
                    <div class="flex items-start gap-3">
                      <span class="icon-[tabler--circle-check] size-5 text-success shrink-0 mt-0.5"></span>
                      <p class="text-ink-muted">{{ point }}</p>
                    </div>
                  @end
                </div>
              </div>
            @end

            @if(item.description)
              <div class="mt-10">
                <h2 class="font-display font-bold text-2xl text-ink">Tentang Kelas Ini</h2>
                <div class="mt-4 leading-relaxed text-ink-muted [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{{ item.description }}}</div>
              </div>
            @end
          </div>

          <aside class="lg:sticky lg:top-24 rounded-2xl border border-border bg-white p-8 shadow-lg">
            <p class="text-sm text-ink-muted">Biaya kelas</p>
            <p class="mt-1 font-mono text-3xl font-bold text-ink tabular-nums">{{ formatRupiah(item.price) }}</p>

            <a href="{{ waLink(site.whatsapp, 'Halo Aloka, saya mau daftar kelas ' + item.title) }}" class="mt-6 flex items-center justify-between gap-3 rounded-full bg-accent-amber pl-6 pr-2 py-2 text-sm font-semibold text-brand-navy transition-colors hover:bg-accent-amber-dark">
              Daftar Kelas Ini
              <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy">
                <span class="icon-[tabler--arrow-right] size-4"></span>
              </span>
            </a>

            <div class="mt-6 pt-6 border-t border-border flex flex-col gap-3 text-sm text-ink-muted">
              <p class="flex items-center gap-2"><span class="icon-[tabler--device-laptop] size-4 text-brand-blue"></span> Akses online, kapan saja</p>
              <p class="flex items-center gap-2"><span class="icon-[tabler--certificate] size-4 text-brand-blue"></span> Sertifikat setelah selesai</p>
            </div>

            @if(item.facilitator && item.facilitator.slug)
              <a href="/fasilitator/{{ item.facilitator.slug }}" class="mt-6 pt-6 border-t border-border flex items-center gap-3">
                <span class="flex items-center justify-center size-11 rounded-full bg-brand-blue/10 text-brand-blue font-display font-bold shrink-0">
                  {{ item.facilitator.name.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() }}
                </span>
                <span>
                  <span class="block text-xs text-ink-muted">Fasilitator</span>
                  <span class="block font-display font-semibold text-sm text-ink">{{ item.facilitator.name }}</span>
                </span>
              </a>
            @end
          </aside>
        </div>
      </div>
    </section>
  @end
@end
