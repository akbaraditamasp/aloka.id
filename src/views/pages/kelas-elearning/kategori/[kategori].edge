@let(activeCategory = courseCategories().find((c) => c.slug === params.kategori))
@if(!activeCategory)
  {{ abort(404) }}
@end
@let(currentPage = Math.max(1, Number(query.page) || 1))
@let(result = await course.read({ filters: { status: 'PUBLISH', category: activeCategory.code }, sort: 'sortOrder', order: 'asc', page: currentPage, limit: 9 }))
@component('layouts/main', { request })
  @slot('title')
    Kelas {{ activeCategory.label }} Koperasi | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-10 md:pb-12">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <a href="/kelas-elearning" class="hover:text-brand-blue transition-colors">Kelas E-Learning</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">{{ activeCategory.label }}</span>
        </nav>

        <div class="mt-8 max-w-2xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Akademi</span>
          <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">
            Kelas {{ activeCategory.label }} Koperasi
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-ink-muted">
            Kumpulan kelas e-learning perkoperasian bertema {{ activeCategory.label.toLowerCase() }} — tonton kapan saja sesuai ritme Anda, dapatkan sertifikat setelah selesai.
          </p>
        </div>
      </div>
    </section>

    @!component('components/course-catalog', { activeCategory, result, basePath: '/kelas-elearning/kategori/' + activeCategory.slug })
  @end
@end
