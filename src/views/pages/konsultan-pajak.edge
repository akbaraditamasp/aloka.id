@let(site = await general.get())
@let(serviceRows = (await service.read({ filters: { category: 'KONSULTAN_PAJAK', status: 'PUBLISH' }, sort: 'sortOrder', order: 'asc', limit: 50, populate: 'none' })).data)
@component('layouts/main', { request })
  @slot('title')
    Konsultan Pajak Koperasi — Lapor &amp; Konsultasi Pajak | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-20">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <nav class="flex items-center gap-2 text-sm text-ink-muted">
          <a href="/" class="hover:text-brand-blue transition-colors">Beranda</a>
          <span class="icon-[tabler--chevron-right] size-3.5"></span>
          <span class="text-ink font-medium">Konsultan Pajak</span>
        </nav>

        <div class="mt-8 grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Konsultan Pajak</span>
            <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">
              Kewajiban Pajak Koperasi, Aman &amp; Tepat Waktu
            </h1>
            <p class="mt-6 text-lg leading-relaxed text-ink-muted max-w-xl">
              Dari pelaporan pajak tahunan, konsultasi pajak SHU, sampai pendampingan pemeriksaan — konsultan pajak Aloka memastikan kewajiban perpajakan koperasi Anda tertib tanpa Anda perlu jadi ahli pajak sendiri.
            </p>

            <div class="mt-8 flex flex-col items-start sm:flex-row sm:flex-wrap sm:items-center gap-4 sm:gap-5">
              <a href="{{ waLink(site.whatsapp, 'Halo Aloka, saya mau konsultasi pajak koperasi') }}" class="group inline-flex items-center gap-3 rounded-full pl-6 pr-2 py-2 text-sm font-semibold text-white shadow-[0_15px_35px_-10px_rgba(19,105,169,0.55)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_22px_45px_-12px_rgba(0,173,238,0.6)]" style="background: linear-gradient(160deg, #00ADEE 0%, #1369A9 45%, #1D4282 75%, #242A6A 100%);">
                Konsultasi Pajak Gratis
                <span class="flex items-center justify-center size-8 rounded-full bg-white text-brand-navy transition-transform duration-300 group-hover:translate-x-1">
                  <span class="icon-[tabler--arrow-right] size-4"></span>
                </span>
              </a>
              <a href="#layanan" class="inline-flex items-center gap-1.5 pl-3 sm:pl-0 mt-1 sm:mt-0 text-sm font-semibold text-brand-blue hover:text-brand-indigo transition-colors">
                Lihat Layanan Pajak
                <span class="icon-[tabler--arrow-down] size-4"></span>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="rounded-2xl border border-border bg-white p-8 shadow-lg">
              <div class="flex items-center gap-3">
                <span class="flex items-center justify-center size-12 rounded-xl bg-brand-blue/10 text-brand-blue shrink-0">
                  <span class="icon-[tabler--calculator] size-6"></span>
                </span>
                <div>
                  <p class="font-display font-semibold text-ink">Kepatuhan Pajak Koperasi</p>
                  <p class="text-xs text-ink-muted">Dikerjakan konsultan, bukan cuma diarahkan</p>
                </div>
              </div>
              <div class="mt-6 flex flex-col gap-4">
                <div class="flex items-start gap-3">
                  <span class="icon-[tabler--circle-check] size-5 text-success shrink-0 mt-0.5"></span>
                  <p class="text-sm text-ink-muted">Lapor tepat waktu, hindari denda &amp; sanksi</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="icon-[tabler--circle-check] size-5 text-success shrink-0 mt-0.5"></span>
                  <p class="text-sm text-ink-muted">Perhitungan pajak SHU sesuai aturan terbaru</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="icon-[tabler--circle-check] size-5 text-success shrink-0 mt-0.5"></span>
                  <p class="text-sm text-ink-muted">Didampingi bila ada pemeriksaan pajak</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="layanan" class="scroll-mt-24 py-16 md:py-24 bg-surface">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="max-w-2xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Layanan Pajak</span>
          <h2 class="mt-3 font-display font-bold text-3xl md:text-4xl text-ink">Perpajakan Koperasi, Diurus Konsultan Berpengalaman</h2>
        </div>

        @!component('components/service-cards', { services: serviceRows })
      </div>
    </section>

    @component('components/closing-cta', {
      eyebrow: 'Bebas Salah Lapor',
      body: 'Konsultasi gratis dengan konsultan pajak Aloka — kami bantu cek status kepatuhan pajak koperasi Anda sekarang.',
      primaryHref: waLink(site.whatsapp, 'Halo Aloka, saya mau konsultasi pajak koperasi'),
      primaryLabel: 'Konsultasi Pajak Gratis',
      secondaryHref: '/',
      secondaryLabel: 'Kembali ke Beranda',
    })
      @slot('icon')
        <span class="icon-[tabler--calculator] size-4"></span>
      @end
      @slot('heading')
        Serahkan Urusan Pajak Koperasi ke Ahlinya
      @end
    @end
  @end
@end
