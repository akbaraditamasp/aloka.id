              <a href="/sertifikasi-bnsp/{{ scheme.slug }}" class="group flex flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-brand-blue/30">
                <span class="flex items-center justify-center size-12 rounded-xl {{ icons[i % icons.length].box }}">
                  <span class="{{ icons[i % icons.length].icon }} size-6"></span>
