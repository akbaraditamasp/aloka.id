@let(site = await general.get())
@let(info = await about.get())
@let(stat = await stats.get())
@component('layouts/main', { request, description: info.vision })
  @slot('title')
    Tentang Aloka — {{ site.tagline }} | Aloka
  @end

  @slot('main')
    <section class="pt-10 md:pt-16 pb-16 md:pb-20">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
