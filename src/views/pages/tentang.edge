        <div class="mt-8 max-w-3xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Tentang Aloka</span>
          <h1 class="mt-4 font-display font-extrabold text-4xl md:text-5xl leading-tight tracking-tight text-brand-navy">{{ info.headline }}</h1>
          <p class="mt-6 text-lg leading-relaxed text-ink-muted">{{ site.description }}</p>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-surface">
      <div class="max-w-7xl mx-auto px-4 md:px-6 grid lg:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-border bg-white p-8 shadow-sm">
          <span class="flex items-center justify-center size-12 rounded-xl bg-brand-blue/10 text-brand-blue">
            <span class="icon-[tabler--eye] size-6"></span>
          </span>
          <h2 class="mt-6 font-display font-semibold text-xl text-ink">Visi</h2>
          <p class="mt-3 leading-relaxed text-ink-muted">{{ info.vision }}</p>
        </div>

        <div class="rounded-2xl border border-border bg-white p-8 shadow-sm">
          <span class="flex items-center justify-center size-12 rounded-xl bg-success/10 text-success">
            <span class="icon-[tabler--target-arrow] size-6"></span>
          </span>
          <h2 class="mt-6 font-display font-semibold text-xl text-ink">Misi</h2>
          <div class="mt-4 flex flex-col gap-3">
            @each(mission in info.missions)
              <div class="flex items-start gap-3">
                <span class="icon-[tabler--circle-check] size-5 text-success shrink-0 mt-0.5"></span>
                <p class="text-ink-muted">{{ mission }}</p>
              </div>
            @end
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <span class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-accent-amber-dark">Cerita Kami</span>
        <div class="mt-4 leading-relaxed text-lg text-ink-muted [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">{{{ info.story }}}</div>
      </div>
    </section>

    <section class="pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="rounded-3xl bg-brand-navy px-8 py-12 md:px-16">
          <div class="grid sm:grid-cols-3 gap-8 sm:gap-0 sm:divide-x sm:divide-white/10 text-center">
            <div>
              <p class="font-mono text-4xl font-bold text-accent-amber tabular-nums">{{ formatNumber(stat.cooperatives) }}+</p>
              <p class="mt-2 text-sm text-white/70">Koperasi Dibina</p>
            </div>
            <div>
              <p class="font-mono text-4xl font-bold text-accent-amber tabular-nums">{{ formatNumber(stat.participants) }}+</p>
              <p class="mt-2 text-sm text-white/70">Peserta Terlatih</p>
            </div>
            <div>
              <p class="font-mono text-4xl font-bold text-accent-amber tabular-nums">{{ formatNumber(stat.facilitators) }}+</p>
              <p class="mt-2 text-sm text-white/70">Fasilitator Aktif</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    @component('components/closing-cta', {
      eyebrow: 'Mari Mulai',
      body: 'Ceritakan kondisi koperasi Anda — konsultasi awal gratis, tanpa komitmen.',
